{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adventura-web",
	"compatibility_date": "2025-10-08",
	// Static assets only: no Worker script, so serving a page costs no CPU
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
